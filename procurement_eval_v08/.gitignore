# 子目录单独作为仓库使用时，同样排除凭据与本地环境。
.env
.env.*
!.env.example
!.env.sample
!.env.template
.aws/
.ssh/
secrets/
credentials.json
credentials.*.json
service-account*.json
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
.venv*/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
~$*

# 运行数据、数据库、日志与开发报告只保留在本机。
runtime_data/
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
*.db
*.db-*
*.log
*.log.*
*.pid
/reports/
backend_contract_results.json

# 原始评估证据与结果不公开；保留目录占位文件。
/evaluation/runs/*
!/evaluation/runs/.gitkeep
/evaluation/reports/*
!/evaluation/reports/.gitkeep
/evaluation/EVAL_*_IMPLEMENTATION_REPORT.md
/evaluation/EVAL_*_SCORING_REPORT.md

# 导出压缩包可能包含原始证据或本机配置，不直接公开。
*.zip
