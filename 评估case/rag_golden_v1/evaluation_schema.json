{
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario_type": {
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "knowledge_type": {
      "enum": [
        "A",
        "B",
        "MIXED"
      ]
    },
    "theme": {
      "type": "string",
      "minLength": 1
    },
    "attributes": {
      "type": "array",
      "items": {
        "enum": [
          "direct",
          "colloquial",
          "implicit_condition",
          "numeric_boundary",
          "distracting_context",
          "conditions_exceptions",
          "partial_evidence",
          "unanswerable",
          "similar_knowledge"
        ]
      },
      "minItems": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "golden_answer": {
      "type": "string",
      "minLength": 1
    },
    "required_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fact_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "required_judgment": {
            "type": "string",
            "minLength": 1
          },
          "source_class": {
            "enum": [
              "A",
              "B"
            ]
          },
          "authority": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "fact_id",
          "text",
          "evidence_ids",
          "required_judgment",
          "source_class",
          "authority"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "golden_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "doc_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": "string",
            "minLength": 1
          },
          "knowledge_unit_id": {
            "type": "string",
            "minLength": 1
          },
          "source_path": {
            "type": "string",
            "minLength": 1
          },
          "evidence_text": {
            "type": "string",
            "minLength": 1
          },
          "source_hash": {
            "type": "string",
            "minLength": 1
          },
          "evidence_hash": {
            "type": "string",
            "minLength": 1
          },
          "fact_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "enum": [
              "fact",
              "scope"
            ]
          },
          "source_class": {
            "enum": [
              "A",
              "B"
            ]
          },
          "source_span": {
            "type": "object",
            "properties": {
              "char_start": {
                "type": "integer",
                "minimum": 0
              },
              "char_end": {
                "type": "integer",
                "minimum": 0
              },
              "line_start": {
                "type": "integer",
                "minimum": 1
              },
              "line_end": {
                "type": "integer",
                "minimum": 1
              },
              "convention": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "char_start",
              "char_end",
              "line_start",
              "line_end",
              "convention"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "evidence_id",
          "doc_id",
          "title",
          "section",
          "knowledge_unit_id",
          "source_path",
          "evidence_text",
          "source_hash",
          "evidence_hash",
          "fact_id",
          "role",
          "source_class",
          "source_span"
        ],
        "additionalProperties": false
      },
      "minItems": 2
    },
    "forbidden_claims": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "answerability": {
      "enum": [
        "FULL",
        "PARTIAL",
        "UNANSWERABLE"
      ]
    },
    "expected_behavior": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "question_conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_text": {
            "type": "string",
            "minLength": 1
          },
          "fact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "treatment": {
            "const": "source_supported_judgment"
          }
        },
        "required": [
          "question_text",
          "fact_ids",
          "treatment"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "missing_information": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "cross_document_reason": {
      "type": "string"
    },
    "fixture": {
      "type": "null"
    },
    "real_time_dependency": {
      "const": false
    },
    "gold_status": {
      "enum": [
        "AUTO_VALIDATED",
        "SKIPPED",
        "NEEDS_DECISION"
      ]
    },
    "case_version": {
      "const": "rag-golden-1.0.0-candidate"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "blueprint_sha256": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "overview_path": {
          "type": "string",
          "minLength": 1
        },
        "overview_sha256": {
          "type": "string",
          "minLength": 1
        },
        "construction": {
          "type": "string",
          "minLength": 1
        },
        "semantic_review": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "blueprint_sha256",
        "source",
        "overview_path",
        "overview_sha256",
        "construction",
        "semantic_review"
      ],
      "additionalProperties": false
    },
    "checker_spec": {
      "type": "object",
      "properties": {
        "integration_status": {
          "type": "string"
        },
        "source_evidence_coverage": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            },
            "unit": {
              "type": "string"
            },
            "fact_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 0
            },
            "rule": {
              "type": "string"
            }
          },
          "required": [
            "required",
            "unit",
            "fact_ids",
            "rule"
          ],
          "additionalProperties": false
        },
        "top_k_necessary_evidence_recall": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            },
            "k": {
              "type": "string"
            },
            "denominator": {
              "type": "string"
            },
            "rule": {
              "type": "string"
            },
            "unmapped_status": {
              "type": "string"
            }
          },
          "required": [
            "required",
            "k",
            "denominator",
            "rule",
            "unmapped_status"
          ],
          "additionalProperties": false
        },
        "cross_document_fact_coverage": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            },
            "rule": {
              "type": "string"
            }
          },
          "required": [
            "required",
            "rule"
          ],
          "additionalProperties": false
        },
        "answer_correctness": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            },
            "fact_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 0
            },
            "rule": {
              "type": "string"
            },
            "forbidden_claims": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 0
            },
            "uncertain_status": {
              "type": "string"
            }
          },
          "required": [
            "required",
            "fact_ids",
            "rule",
            "forbidden_claims",
            "uncertain_status"
          ],
          "additionalProperties": false
        },
        "answer_faithfulness": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            },
            "rule": {
              "type": "string"
            }
          },
          "required": [
            "required",
            "rule"
          ],
          "additionalProperties": false
        },
        "insufficient_evidence": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            },
            "missing_information": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 0
            },
            "rule": {
              "type": "string"
            }
          },
          "required": [
            "required",
            "missing_information",
            "rule"
          ],
          "additionalProperties": false
        },
        "agent_tool_route": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            },
            "route_family": {
              "type": "string"
            },
            "expected_action": {
              "type": "string"
            },
            "expected_tool": {
              "type": "string"
            },
            "reuse": {
              "type": "string"
            },
            "evidence": {
              "type": "string"
            },
            "requirement": {
              "type": "string"
            }
          },
          "required": [
            "required",
            "route_family",
            "expected_action",
            "expected_tool",
            "reuse",
            "evidence",
            "requirement"
          ],
          "additionalProperties": false
        },
        "no_business_write": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            },
            "allow_write": {
              "type": "boolean"
            },
            "reuse": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 0
            },
            "precondition": {
              "type": "string"
            },
            "rule": {
              "type": "string"
            }
          },
          "required": [
            "required",
            "allow_write",
            "reuse",
            "precondition",
            "rule"
          ],
          "additionalProperties": false
        },
        "result_contract": {
          "type": "object",
          "properties": {
            "evidence": {
              "type": "string"
            },
            "scored": {
              "type": "string"
            },
            "criterion_statuses": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 0
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "evidence",
            "scored",
            "criterion_statuses",
            "note"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "integration_status",
        "source_evidence_coverage",
        "top_k_necessary_evidence_recall",
        "cross_document_fact_coverage",
        "answer_correctness",
        "answer_faithfulness",
        "insufficient_evidence",
        "agent_tool_route",
        "no_business_write",
        "result_contract"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "case_id",
    "scenario_type",
    "knowledge_type",
    "theme",
    "attributes",
    "question",
    "golden_answer",
    "required_facts",
    "golden_evidence",
    "forbidden_claims",
    "answerability",
    "expected_behavior",
    "question_conditions",
    "missing_information",
    "cross_document_reason",
    "fixture",
    "real_time_dependency",
    "gold_status",
    "case_version",
    "provenance",
    "checker_spec"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent procurement RAG Golden candidate",
  "$comment": "Schema用于Golden Case；skipped_cases为审计排除记录，可无golden。额外语义及跨字段检查由golden_dataset.py执行。"
}
